APP_NAME="Expenses System"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://despesas.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Currency & Locale Configuration
# Make sure APP_LOCALE matches your currency region for proper formatting
#
# Examples:
# US Dollar:    APP_CURRENCY=USD, APP_LOCALE=en_US (1,500.00)
# Brazilian:    APP_CURRENCY=BRL, APP_LOCALE=pt_BR (1.500,00)
# Euro (DE):    APP_CURRENCY=EUR, APP_LOCALE=de_DE (1.500,00)
# Euro (FR):    APP_CURRENCY=EUR, APP_LOCALE=fr_FR (1 500,00)
# British:      APP_CURRENCY=GBP, APP_LOCALE=en_GB (1,500.00)
#
APP_CURRENCY=USD

# Country Configuration (ISO 3166-1 alpha-2)
# Used for address formatting and field visibility
#
# Examples:
# US - United States: Shows Street, City, State, Postal Code
# BR - Brazil:        Shows Street, City, State, Postal Code, Neighborhood (Bairro)
#
APP_COUNTRY=US

# Google Maps API Configuration
# Required for address autocomplete and geocoding (latitude/longitude)
# Enable these APIs in Google Cloud Console: Places API, Geocoding API, Maps JavaScript API
GOOGLE_MAPS_API_KEY=

# Visual Crossing Weather API Configuration
# Required for weather data in daily reports (historical and forecast)
# Get your API key at: https://www.visualcrossing.com/
VISUAL_CROSSING_API_KEY=

# CardPointe Payment Gateway Configuration
# Optional — when unset, card payment features are hidden (isConfigured() = false)
# CARDPOINTE_ENV: 'uat' for testing, 'prod' for live payments
CARDPOINTE_ENV=uat
CARDPOINTE_MERCHANT_ID=
CARDPOINTE_API_USER=
CARDPOINTE_API_PASS=
CARDPOINTE_SITE=fts-uat

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# Document repository (projects & job sites)
#
# Leave DOCUMENTS_DISK=local and the repository stores files on the server's
# private disk, capped by PHP's upload limits. Set it to r2 and fill in the
# four R2 values below to store documents on Cloudflare R2 with direct
# browser-to-bucket uploads (no size ceiling worth speaking of).
# See docs/deployment-cloudflare-r2.md.
# ---------------------------------------------------------------------------
DOCUMENTS_DISK=local
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
# Optional: only needed if the bucket is served through a custom public domain
R2_PUBLIC_URL=
# How long a download/preview link stays valid, in seconds
DOCUMENTS_PRESIGN_TTL=60
# Optional overrides — sensible defaults live in config/documents.php
# DOCUMENTS_MAX_UPLOAD=5368709120
# DOCUMENTS_RETENTION_DAYS=30
# DOCUMENTS_SHARE_DAYS=14
# DOCUMENTS_QUOTA=

VITE_APP_NAME="${APP_NAME}"
